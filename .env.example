# Copie para .env e preencha. O .env não vai para o git.

# Porta do servidor local
PORT=4000

# Connection string do MongoDB. As rotas de reação e comentário usam transação,
# que exige replica set — um mongod standalone faz as duas falharem.

# MongoDB local convertido para replica set de nó único (ver README):
MONGODB_URI=mongodb://localhost:27017/calibre?replicaSet=rs0

# Atlas (já é replica set, não precisa de parâmetro extra):
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/calibre?retryWrites=true&w=majority

# Segredo de assinatura do JWT — gere um valor aleatório longo
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Validade do token emitido no login
JWT_EXPIRES_IN=7d
