{
  "name": "calibre-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end do Calibre — clube de colecionadores de relógios",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
