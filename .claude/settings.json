{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-commit-on-main.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Verificando a branch atual..."
          }
        ]
      }
    ]
  }
}
